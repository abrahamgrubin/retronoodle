# Copy to .env and fill in. Never commit .env.

# Which services this process starts: api | worker | all
ROLE=all
PORT=3000

# Supabase (Project Settings > API). The service role key stays server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings > Database), used by the API and pg-boss
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Web app (Vite exposes only VITE_* variables to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000

# Allowed browser origin for CORS
WEB_ORIGIN=http://localhost:5173

# Google sign-in is configured in Supabase (Authentication > Providers > Google),
# using a Google Cloud OAuth client. Redirect URL: https://YOUR-PROJECT.supabase.co/auth/v1/callback

# Anthropic (RN-017, RN-021). Monthly spend cap enforced in config.
ANTHROPIC_API_KEY=
AI_MONTHLY_CAP_USD=5

# RN-031: wraps every team's own transcript data key (Render env secret now, AWS KMS in
# production). Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TRANSCRIPT_MASTER_KEY=
