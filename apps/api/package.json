{
  "name": "@retronoodle/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean --noExternal @retronoodle/shared --noExternal @retronoodle/worker",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@retronoodle/shared": "workspace:*",
    "@retronoodle/worker": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.12.5",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
